            biostride_func:is_drug_like true ;
            biostride_func:ligand_id "CHEMBL3545110" ;
            biostride_func:ligand_name "Nutlin-3a" ] ;
    biostride_func:mutations biostride:p53-mut-001,
        biostride:p53-mut-002,
        biostride:p53-mut-003 ;
    biostride_func:organism "Homo sapiens" ;
