            owl:onProperty biostride_schema:voxel_size ],
        biostride_schema:Image ;
    skos:definition "A 3D volume or tomogram" ;
    skos:inScheme biostride: .

biostride_schema:ImageFeature a owl:Class ;
    rdfs:label "ImageFeature" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biostride_schema:terms ],
        [ a owl:Restriction ;
