    rdfs:label "ProteinAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/biostride/functional-annotation/annotation_method> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/biostride/functional-annotation/chain_id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[0-9][A-Za-z0-9]{3}$" ] ) ] ;
            owl:onProperty <https://w3id.org/biostride/functional-annotation/pdb_entry> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/biostride/functional-annotation/annotation_method> ],
        [ a owl:Restriction ;
