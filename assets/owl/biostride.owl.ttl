biostride_schema:Image3D a owl:Class ;
    rdfs:label "Image3D" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biostride_schema:reconstruction_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biostride_schema:dimensions_z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty biostride_schema:voxel_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty biostride_schema:dimensions_z ],
        [ a owl:Restriction ;
