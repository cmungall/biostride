        [ a owl:Restriction ;
            owl:allValuesFrom biostride_schema:OntologyTerm ;
            owl:onProperty biostride_schema:terms ],
        biostride_schema:AttributeGroup ;
    skos:definition "Semantic annotations describing features identified in images using controlled vocabulary terms" ;
    skos:inScheme biostride: .

