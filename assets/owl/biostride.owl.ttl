            owl:onProperty biostride_schema:emission_wavelength ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biostride_schema:quantum_yield ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty biostride_schema:excitation_wavelength ],
        biostride_schema:Image2D ;
